{
  "name": "travelvip-unfiltered-qa",
  "version": "1.0.0",
  "description": "Unfiltered TravelVIP API QA — raw reports, payloads, BRs. Manual to automation. Hotel, Flight, Cab, Lounge, FastTrack & more.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:auth": "npm test -- tests/auth",
    "test:auth:security": "npm test -- tests/auth/security.test.js",
    "test:partner": "npm test -- tests/partner.test.js",
    "test:flight": "npm run test:flight:report -- tests/flight/search.test.js tests/flight/negative.test.js",
    "test:flight:all": "npm run test:flight:report -- tests/flight",
    "test:flight:validation": "npm run test:flight:report -- tests/flight/validation.oneway.test.js tests/flight/validation.roundtrip.test.js",
    "test:flight:connecting": "npm run test:flight:report -- tests/flight/connecting.search.test.js",
    "probe:connecting": "node travel-apis/flight/scripts/probe-connecting-flights.js",
    "test:flight:report": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.flight.config.js --runInBand",
    "test:flight:search": "npm run test:flight:report -- tests/flight/search.test.js",
    "test:flight:negative": "npm run test:flight:report -- tests/flight/negative.test.js tests/flight/issue-ticket.negative.test.js",
    "test:flight:core": "npm run test:flight:report -- tests/flight/search.test.js tests/flight/negative.test.js tests/flight/validation.oneway.test.js tests/flight/validation.roundtrip.test.js",
    "test:flight:ow": "npm run test:flight:report -- tests/flight/oneway.e2e.test.js",
    "test:flight:rt": "npm run test:flight:report -- tests/flight/roundtrip.e2e.test.js",
    "test:hotel": "npm run test:hotel:report -- tests/hotel/search.test.js tests/hotel/negative.test.js",
    "test:hotel:all": "npm run test:hotel:report -- tests/hotel",
    "test:hotel:report": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.hotel.config.js --runInBand",
    "test:hotel:search": "npm run test:hotel:report -- tests/hotel/search.test.js",
    "test:hotel:negative": "npm run test:hotel:report -- tests/hotel/negative.test.js",
    "test:hotel:e2e": "npm run test:hotel:report -- tests/hotel/e2e.test.js",
    "hotel:regression": "node travel-apis/hotel/scripts/hotel-regression-suite.js",
    "hotel:regression:smoke": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags SMOKE,ENCRYPT,CORR",
    "hotel:regression:listing": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags LISTING",
    "hotel:regression:validate": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags AUTH,VALIDATE",
    "hotel:regression:starbook": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags STARBOOK",
    "hotel:regression:deploy": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags UNAVAIL,STARSRP,CHAINBRAND,CHAINBRANDVAL",
    "hotel:regression:unavail": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags UNAVAIL",
    "hotel:regression:starsrp": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags STARSRP",
    "hotel:regression:chainbrand": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags CHAINBRAND",
    "hotel:regression:chainbrandval": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags CHAINBRANDVAL",
    "hotel:regression:negprice": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags NEGPRICE",
    "hotel:regression:report": "node travel-apis/hotel/scripts/render-hotel-regression-report.js",
    "flight:regression": "node travel-apis/flight/scripts/flight-regression-suite.js",
    "flight:regression:smoke": "node travel-apis/flight/scripts/flight-regression-suite.js --tags SMOKE,CORR",
    "flight:regression:validate": "node travel-apis/flight/scripts/flight-regression-suite.js --tags AUTH,VALIDATE",
    "probe:flight:faretypes": "node travel-apis/flight/scripts/probe-flight-v2-faretypes-filter-canary.js",
    "flight:regression:report": "node travel-apis/flight/scripts/render-flight-regression-report.js",
    "b2b:regression": "node travel-apis/flight/scripts/b2b-regression-suite.js",
    "b2b:regression:smoke": "node travel-apis/hotel/scripts/hotel-regression-suite.js --tags SMOKE,ENCRYPT,CORR && node travel-apis/flight/scripts/flight-regression-suite.js --tags SMOKE,CORR",
    "test:esim": "npm test -- tests/esim.test.js",
    "test:lounge": "npm test -- tests/lounge.test.js",
    "test:fasttrack": "npm test -- tests/fasttrack.test.js",
    "test:cab": "npm test -- tests/cab/e2e.test.js",
    "test:cab:e2e": "npm test -- tests/cab/e2e.test.js",
    "cab:regression:validate": "node travel-apis/cab/scripts/probe-cab-error-contract.js --tags VALIDATE,FILTERS,LIVE",
    "cab:regression:validate:staging": "node travel-apis/cab/scripts/probe-cab-error-contract.js --env staging --tags VALIDATE,FILTERS,LIVE",
    "cab:regression:validate:canary": "node travel-apis/cab/scripts/probe-cab-error-contract.js --env canary --tags VALIDATE,FILTERS,LIVE",
    "probe:cab:error-contract": "node travel-apis/cab/scripts/probe-cab-error-contract.js",
    "cab:export:error-contract": "node travel-apis/cab/scripts/export-cab-error-contract-csv.js",
    "report:lounge": "node inventory/lounge/scripts/generate-lounge-availability-report.js",
    "report:fasttrack": "node inventory/fasttrack/scripts/generate-fasttrack-availability-report.js",
    "report:zero-terminals": "node inventory/lounge/scripts/list-zero-count-terminals.js",
    "probe:auth": "node travel-apis/flight/scripts/probe-auth-payload-validations.js",
    "postman:build": "node travel-apis/flight/scripts/build-dynamic-flight-hotel-postman-collection.js",
    "tvip": "node bin/tvip.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "pdfkit": "^0.19.1",
    "xlsx": "^0.18.5"
  }
}
