  "dbSqlAfter": {
    "trip": "SELECT event, provider_timestamp, provider_datetime, latitude, longitude FROM booking_item_cab_trip WHERE booking_item_cab_id=(SELECT bic.id FROM booking b JOIN booking_item bi ON bi.booking_id=b.id AND bi.service_type='cabs' JOIN booking_item_cab bic ON bic.booking_item_id=bi.id WHERE b.booking_reference='BR1788766708272500') ORDER BY event",
    "cabTotals": "SELECT otp, total_travelled_km, total_travelled_fare, extra_travelled_km, extra_travelled_fare, night_charges, reason FROM booking_item_cab WHERE id=(SELECT bic.id FROM booking b JOIN booking_item bi ON bi.booking_id=b.id AND bi.service_type='cabs' JOIN booking_item_cab bic ON bic.booking_item_id=bi.id WHERE b.booking_reference='BR1788766708272500')",
    "statusHistory": "SELECT m.status_code, h.provider_timestamp FROM booking_item_status_history h JOIN booking_status_mapping m ON m.id=h.status_mapping_id JOIN booking_item bi ON bi.id=h.booking_item_id JOIN booking b ON b.id=bi.booking_id WHERE b.booking_reference='BR1788766708272500' ORDER BY h.id"
  }
